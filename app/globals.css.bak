@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --graphite: #26313f;
  --porcelain: #eef1f0;
  --surface: #eef1f0;
  --lime: #e8735f;
  --cobalt: #5c7a80;
  --sky: #8a95a1;
  --mist: #8a95a1;
  --ink-muted: #5c7a80;
  --line-dark: rgba(255, 255, 255, 0.2);
  --line-light: rgba(38, 49, 63, 0.14);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: auto;
  background: var(--porcelain);
  position: relative;
  scrollbar-color: rgba(232, 115, 95, 0.72) #eef1f0;
  scrollbar-gutter: stable;
  scrollbar-width: thin;
}

html::-webkit-scrollbar {
  width: 10px;
}

html::-webkit-scrollbar-track {
  background: var(--porcelain);
}

html::-webkit-scrollbar-thumb {
  background: rgba(232, 115, 95, 0.7);
  border: 2px solid var(--porcelain);
  border-radius: 999px;
}

html::-webkit-scrollbar-thumb:hover {
  background: var(--lime);
}

body {
  margin: 0;
  overflow-x: hidden;
  background: var(--porcelain);
  color: var(--graphite);
  font-family: var(--font-outfit), Arial, sans-serif;
  font-weight: 400;
  text-rendering: optimizeLegibility;
}

button,
input,
select,
textarea {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

a {
  color: inherit;
  text-decoration: none;
}

::selection {
  background: var(--lime);
  color: var(--graphite);
}

.shell {
  width: min(100% - 2.5rem, 1440px);
  margin-inline: auto;
}

.section-pad {
  padding-block: clamp(6rem, 12vw, 12rem);
}

.display-xl {
  font-size: clamp(3.4rem, 5.8vw, 6.25rem);
  line-height: 0.93;
  letter-spacing: -0.075em;
}

.display-lg {
  font-size: clamp(3rem, 6vw, 7rem);
  line-height: 0.92;
  letter-spacing: -0.075em;
}

.eyebrow {
  color: var(--ink-muted);
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.17em;
  line-height: 1.2;
  text-transform: uppercase;
}

.link-arrow {
  align-items: center;
  display: inline-flex;
  gap: 0.75rem;
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.link-arrow::after {
  content: "↗";
  font-size: 1.1rem;
  transition: transform 220ms ease;
}

.link-arrow:hover::after,
.link-arrow:focus-visible::after {
  transform: translate(0.2rem, -0.2rem);
}

:focus-visible {
  outline: 3px solid var(--lime);
  outline-offset: 4px;
}

.nav-wrap {
  backdrop-filter: blur(14px);
  background: rgba(38, 49, 63, 0.95);
  border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  left: 0;
  position: fixed;
  right: 0;
  top: 0;
  transition: background-color 280ms ease, border-color 280ms ease, box-shadow 280ms ease;
  will-change: transform, opacity;
  z-index: 40;
}

.nav-wrap.is-hidden {
  pointer-events: none;
}

.nav-inner {
  align-items: center;
  color: var(--porcelain);
  display: grid;
  gap: 2rem;
  grid-template-columns: 1fr auto 1fr;
  min-height: 4.75rem;
  padding-block: 0.6rem;
  position: relative;
}

.nav-wrap.is-scrolled {
  background: rgba(38, 49, 63, 0.98);
  border-color: rgba(255, 255, 255, 0.26);
  box-shadow: 0 14px 38px rgba(38, 49, 63, 0.2);
}

.wordmark {
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  white-space: nowrap;
}

.wordmark span {
  color: var(--lime);
}

.nav-inner .wordmark span {
  color: var(--lime);
}

.nav-links {
  align-items: center;
  display: flex;
  gap: clamp(1rem, 2.4vw, 2.4rem);
  justify-self: center;
}

.nav-cta {
  justify-self: end;
}

.nav-links a {
  color: rgba(255, 255, 255, 0.78);
  font-size: 0.8rem;
  transition: color 180ms ease;
}

.nav-links a:hover,
.nav-links a:focus-visible {
  color: var(--porcelain);
}

.button {
  align-items: center;
  border: 1px solid transparent;
  border-radius: 999px;
  cursor: pointer;
  display: inline-flex;
  font-size: 0.8rem;
  font-weight: 600;
  gap: 0.6rem;
  justify-content: center;
  min-height: 2.75rem;
  padding: 0.65rem 1.15rem;
  transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease;
}

.button:hover {
  transform: translateY(-2px);
}

.button-lime {
  background: var(--lime);
  color: var(--graphite);
}

.button-lime:hover,
.button-lime:focus-visible {
  background: #d96351;
}

.nav-cta {
  background: var(--porcelain);
  color: var(--graphite);
}

.nav-cta:hover,
.nav-cta:focus-visible {
  background: var(--lime);
  color: var(--graphite);
}

.button-ghost {
  border-color: rgba(38, 49, 63, 0.2);
  color: var(--graphite);
}

.button-ghost:hover,
.button-ghost:focus-visible {
  background: rgba(38, 49, 63, 0.06);
}

.button-ghost-light {
  border-color: rgba(238, 241, 240, 0.32);
  color: var(--porcelain);
}

.button-ghost-light:hover,
.button-ghost-light:focus-visible {
  background: rgba(238, 241, 240, 0.1);
}

.hero .button-ghost-light {
  border-color: rgba(38, 49, 63, 0.24);
  color: var(--graphite);
}

.hero .button-ghost-light:hover,
.hero .button-ghost-light:focus-visible {
  background: rgba(232, 115, 95, 0.1);
  border-color: rgba(232, 115, 95, 0.5);
}

.menu-toggle {
  background: transparent;
  border: 0;
  color: var(--porcelain);
  cursor: pointer;
  display: none;
  height: 2.7rem;
  padding: 0;
  width: 2.7rem;
}

.menu-toggle span,
.menu-toggle::before,
.menu-toggle::after {
  background: currentColor;
  content: "";
  display: block;
  height: 1px;
  margin: 5px auto;
  transition: transform 180ms ease;
  width: 1.15rem;
}

.hero {
  background: linear-gradient(135deg, #eef1f0 0%, #e5e8e7 58%, #d9dfdf 100%);
  color: var(--graphite);
  min-height: 100svh;
  overflow: hidden;
  position: relative;
}

.hero::before {
  content: none;
}

.hero-rings {
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  position: absolute;
  z-index: 1;
}

.hero-ring {
  position: absolute;
  will-change: opacity, transform;
}

.hero-ring img {
  display: block;
  height: 100%;
  user-select: none;
  width: 100%;
  will-change: transform;
}

.hero-ring-large {
  height: clamp(40rem, 65vw, 62rem);
  right: clamp(-14rem, -10vw, -6rem);
  top: clamp(-15rem, -11vw, -7rem);
  width: clamp(40rem, 65vw, 62rem);
}

.hero-ring-small {
  bottom: clamp(-6rem, -4vw, -3rem);
  height: clamp(15rem, 26vw, 24rem);
  left: clamp(-6rem, -4vw, -3rem);
  width: clamp(15rem, 26vw, 24rem);
}

.hero-ring-small img {
  filter: contrast(1.35) saturate(1.3);
}

.hero-stage {
  min-height: 100svh;
  position: relative;
  z-index: 2;
}

.hero-sticky {
  align-items: center;
  display: flex;
  justify-content: center;
  min-height: 100svh;
  padding-bottom: clamp(4.5rem, 8vh, 7rem);
  padding-top: clamp(8.5rem, 15vh, 11rem);
}

.hero-copy {
  align-items: center;
  display: flex;
  flex-direction: column;
  max-width: 62rem;
  position: relative;
  text-align: center;
  z-index: 2;
}

.hero-copy h1 {
  font-size: clamp(2.75rem, 5vw, 5.45rem);
  line-height: 0.98;
  margin: 0;
  max-width: 59rem;
}

.hero-copy p {
  color: rgba(38, 49, 63, 0.66);
  font-size: clamp(1rem, 1.35vw, 1.3rem);
  line-height: 1.45;
  margin: 0 auto;
  max-width: 39rem;
}

.hero-actions {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem;
  justify-content: center;
  margin-top: 2.4rem;
}

.hero-message {
  color: var(--lime);
  display: block;
  font-size: clamp(3.1rem, 6vw, 6.5rem);
  letter-spacing: -0.075em;
  line-height: 0.92;
  margin: 1.05rem 0 1.7rem;
  min-height: 0.95em;
  position: relative;
  width: 100%;
}

.hero-message span {
  inset: 0;
  position: absolute;
  width: 100%;
}


.built-for {
  /* background: var(--graphite); */
  overflow: hidden;
  padding-block: clamp(0.75rem, 1.4vw, 1.25rem);
  position: relative;
}

.built-for-panel {
  background: #f3f4f3;
  border-radius: 1rem;
  padding: clamp(3rem, 6vw, 6.5rem) clamp(1.5rem, 6vw, 6.5rem);
}

.built-for-intro {
  align-items: start;
  display: grid;
  gap: clamp(2.5rem, 7vw, 8rem);
  grid-template-columns: minmax(0, 1.2fr) minmax(20rem, 0.8fr);
  margin-bottom: clamp(3.5rem, 6vw, 6rem);
}

.built-for-title-reveal {
  margin-bottom: -0.12em;
  padding-bottom: 0.12em;
}

.built-for-intro h2 {
  font-size: clamp(3.2rem, 5vw, 5.7rem);
  letter-spacing: -0.065em;
  line-height: 0.94;
  margin: 0;
  white-space: nowrap;
}

.built-for-lede {
  display: grid;
  gap: 1rem;
  padding-top: 0.25rem;
}

.built-for-lede p {
  color: rgba(38, 49, 63, 0.7);
  font-size: clamp(1rem, 1.25vw, 1.2rem);
  line-height: 1.55;
  margin: 0;
  max-width: 37rem;
}

.built-for-grid {
  display: grid;
  gap: clamp(0.8rem, 1.4vw, 1.2rem);
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.built-for-card {
  background: #e2e7e6;
  border: 1px solid rgba(38, 49, 63, 0.12);
  border-radius: 1.2rem;
  box-shadow: 0 8px 22px rgba(38, 49, 63, 0.08);
  display: flex;
  flex-direction: column;
  min-height: clamp(21rem, 27vw, 27rem);
  overflow: hidden;
  padding: clamp(1.5rem, 2.8vw, 2.6rem);
  position: relative;
  transform-origin: center bottom;
}

.built-for-card:nth-child(1) {
  background: linear-gradient(135deg, #102b4a 0%, #1a3858 100%);
  border-color: #173452;
  color: var(--porcelain);
}

.built-for-card:nth-child(2) {
  background: #e4e5e5;
}

.built-for-card:nth-child(3) {
  background: #aebdb5;
}

.built-for-card:nth-child(4) {
  background: #f6f7f6;
}

.built-for-icon {
  display: block;
  height: 3rem;
  margin-bottom: clamp(2.3rem, 4vw, 4rem);
  overflow: visible;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.45;
  width: 3rem;
}

.built-for-card-copy h3 {
  font-size: clamp(2.15rem, 3.4vw, 3.8rem);
  letter-spacing: -0.055em;
  line-height: 0.96;
  margin: 0 0 0.9rem;
  max-width: 27rem;
}

.built-for-card-copy p {
  color: rgba(38, 49, 63, 0.68);
  line-height: 1.52;
  margin: 0;
  max-width: 31rem;
}

.built-for-card:nth-child(1) .built-for-card-copy p {
  color: rgba(238, 241, 240, 0.68);
}

.built-for-card-index {
  align-items: center;
  display: flex;
  gap: 0.75rem;
  margin-top: auto;
  padding-top: 2rem;
}

.built-for-number {
  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 0.04em;
}

.built-for-index-line {
  background: currentColor;
  height: 1px;
  opacity: 0.25;
  width: clamp(5rem, 10vw, 8rem);
}

.section-light {
  background: var(--porcelain);
}

.section-dark {
  background: var(--graphite);
  color: var(--porcelain);
}

.section-intro {
  align-items: end;
  display: flex;
  gap: 2rem;
  justify-content: space-between;
  margin-bottom: clamp(3rem, 7vw, 6rem);
}

.section-intro h2 {
  font-size: clamp(2.8rem, 6.3vw, 7rem);
  letter-spacing: -0.07em;
  line-height: 0.92;
  margin: 0;
  max-width: 47rem;
}

.section-intro p {
  color: rgba(38, 49, 63, 0.64);
  line-height: 1.5;
  margin: 0;
  max-width: 20rem;
}

.bento {
  display: grid;
  gap: 0.75rem;
  grid-auto-flow: dense;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  grid-template-rows: repeat(2, minmax(18rem, 1fr));
}

.outcome-card {
  border-radius: 0.9rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 18rem;
  overflow: hidden;
  padding: clamp(1.5rem, 3vw, 2.75rem);
  position: relative;
}

.outcome-card:nth-child(1) {
  grid-column: span 7;
  grid-row: span 2;
}

.outcome-card:nth-child(2) {
  grid-column: span 5;
}

.outcome-card:nth-child(3) {
  grid-column: span 2;
}

.outcome-card:nth-child(4) {
  grid-column: span 3;
}

.outcome-card h3 {
  font-size: clamp(1.4rem, 2.5vw, 2.9rem);
  letter-spacing: -0.055em;
  line-height: 0.98;
  margin: 0;
  max-width: 21rem;
}

.outcome-card p {
  font-size: 0.95rem;
  line-height: 1.42;
  margin: 1.5rem 0 0;
  max-width: 25rem;
}

.outcome-card .card-note {
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.outcome-card::after {
  border: 1px solid currentColor;
  border-radius: 50%;
  content: "";
  height: 10rem;
  opacity: 0.12;
  position: absolute;
  right: -3rem;
  top: -3rem;
  width: 10rem;
}

.outcome-lime {
  background: var(--lime);
}

.outcome-porcelain {
  background: var(--surface);
}

.outcome-cobalt {
  background: var(--cobalt);
  color: var(--porcelain);
}

.outcome-mist {
  background: var(--mist);
}

.capabilities {
  background: var(--graphite);
  color: var(--porcelain);
}

.capabilities .section-intro p {
  color: rgba(238, 241, 240, 0.6);
}

.capability-layout {
  display: grid;
  gap: clamp(2rem, 6vw, 7rem);
  grid-template-columns: minmax(240px, 0.34fr) minmax(0, 1fr);
}

.capability-nav {
  border-top: 1px solid var(--line-dark);
}

.capability-tab {
  align-items: center;
  background: transparent;
  border: 0;
  border-bottom: 1px solid var(--line-dark);
  color: rgba(238, 241, 240, 0.48);
  cursor: pointer;
  display: flex;
  font-size: clamp(1.45rem, 2.7vw, 2.7rem);
  justify-content: space-between;
  letter-spacing: -0.05em;
  padding: 1.25rem 0;
  text-align: left;
  transition: color 180ms ease, padding 180ms ease;
  width: 100%;
}

.capability-tab::after {
  content: "↗";
  font-size: 1.35rem;
  opacity: 0;
  transform: translate(-0.5rem, 0.5rem);
  transition: opacity 180ms ease, transform 180ms ease;
}

.capability-tab:hover,
.capability-tab:focus-visible,
.capability-tab.is-active {
  color: var(--porcelain);
  padding-left: 0.4rem;
}

.capability-tab.is-active::after,
.capability-tab:hover::after,
.capability-tab:focus-visible::after {
  opacity: 1;
  transform: translate(0, 0);
}

.capability-detail {
  background: #202a37;
  border-radius: 0.9rem;
  min-height: 31rem;
  overflow: hidden;
  padding: clamp(1.5rem, 4vw, 4.5rem);
  position: relative;
}

.capability-detail::before {
  border: 1px solid rgba(232, 115, 95, 0.5);
  border-radius: 50%;
  content: "";
  height: 27rem;
  position: absolute;
  right: -10rem;
  top: -10rem;
  width: 27rem;
}

.capability-detail h3 {
  font-size: clamp(2.4rem, 5vw, 5.4rem);
  letter-spacing: -0.07em;
  line-height: 0.9;
  margin: 1.4rem 0 1.6rem;
  max-width: 35rem;
  position: relative;
}

.capability-detail p {
  color: rgba(238, 241, 240, 0.68);
  line-height: 1.5;
  max-width: 30rem;
  position: relative;
}

.capability-bullets {
  border-top: 1px solid var(--line-dark);
  display: grid;
  gap: 0.8rem;
  grid-template-columns: repeat(3, 1fr);
  list-style: none;
  margin: 3.5rem 0 0;
  padding: 1.1rem 0 0;
  position: relative;
}

.capability-bullets li {
  color: rgba(238, 241, 240, 0.85);
  font-size: 0.8rem;
  line-height: 1.35;
}

.capability-bullets li::before {
  color: var(--lime);
  content: "↗";
  display: block;
  font-size: 1rem;
  margin-bottom: 1.1rem;
}

.process {
  background: var(--graphite);
  overflow: clip;
  position: relative;
}

.process-stage {
  min-height: 270svh;
  position: relative;
}

.process-sticky {
  height: 100svh;
  position: sticky;
  top: 0;
}

.process-panel {
  background: linear-gradient(135deg, #202a37 0%, #26313f 58%, #40565e 100%);
  color: var(--porcelain);
  height: 100%;
  overflow: hidden;
  position: relative;
}

.process-panel::before {
  background-image: linear-gradient(rgba(255, 255, 255, 0.055) 1px, transparent 1px);
  background-size: 100% 12.5%;
  content: "";
  inset: 0;
  pointer-events: none;
  position: absolute;
}

.process-content {
  display: grid;
  grid-template-columns: minmax(0, 1.02fr) minmax(32rem, 0.98fr);
  height: 100%;
  padding: clamp(6.8rem, 10vh, 9rem) clamp(1.5rem, 5vw, 6rem) clamp(2rem, 4vw, 4.5rem);
  position: relative;
  z-index: 2;
}

.process-heading {
  align-self: start;
  max-width: 53rem;
}

.process-kicker {
  color: var(--lime);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  margin: 0 0 1.5rem;
  text-transform: uppercase;
}

.process-heading h2 {
  font-size: clamp(4rem, 8.5vw, 9.8rem);
  letter-spacing: -0.085em;
  line-height: 0.84;
  margin: 0;
  max-width: 8ch;
}

.process-heading > p:last-child {
  color: rgba(255, 255, 255, 0.67);
  font-size: clamp(0.98rem, 1.15vw, 1.2rem);
  line-height: 1.5;
  margin: clamp(1.6rem, 3vh, 3rem) 0 0;
  max-width: 37rem;
}

.process-day {
  align-self: center;
  border-top: 1px solid rgba(255, 255, 255, 0.23);
  margin-left: clamp(1rem, 5vw, 7rem);
  position: relative;
  z-index: 2;
}

.process-moment {
  border-bottom: 1px solid rgba(255, 255, 255, 0.23);
  display: grid;
  gap: clamp(1rem, 2.5vw, 3rem);
  grid-template-columns: 4.5rem 1fr;
  opacity: 0.38;
  padding: clamp(1.2rem, 2.6vh, 2rem) 0;
  transition: opacity 420ms ease, transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
}

.process-moment.is-active {
  opacity: 1;
  transform: translateX(-0.75rem);
}

.process-moment time {
  color: var(--lime);
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  padding-top: 0.3rem;
}

.process-moment h3 {
  font-size: clamp(1.45rem, 2.2vw, 2.65rem);
  letter-spacing: -0.055em;
  line-height: 1;
  margin: 0 0 0.65rem;
}

.process-moment p {
  color: rgba(255, 255, 255, 0.62);
  line-height: 1.45;
  margin: 0;
  max-width: 31rem;
}

.process-bottomline {
  align-self: end;
  border-top: 1px solid rgba(255, 255, 255, 0.23);
  display: flex;
  gap: 2rem;
  grid-column: 1 / -1;
  justify-content: space-between;
  padding-top: 1rem;
  position: absolute;
  bottom: clamp(1.5rem, 3vw, 3rem);
  left: clamp(1.5rem, 5vw, 6rem);
  right: clamp(1.5rem, 5vw, 6rem);
}

.process-bottomline span {
  color: var(--lime);
  font-size: 0.66rem;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.process-bottomline strong {
  font-size: clamp(0.85rem, 1.1vw, 1.05rem);
  font-weight: 400;
}

.process-clock {
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  height: min(42vw, 40rem);
  left: 42%;
  opacity: 0.38;
  pointer-events: none;
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: min(42vw, 40rem);
  z-index: -1;
}

.process-clock::before,
.process-clock::after {
  background: rgba(255, 255, 255, 0.12);
  content: "";
  left: 50%;
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
}

.process-clock::before {
  height: 1px;
  width: 100%;
}

.process-clock::after {
  height: 100%;
  width: 1px;
}

.process-clock-center {
  background: var(--lime);
  border-radius: 50%;
  height: 0.55rem;
  left: 50%;
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 0.55rem;
}

.process-clock-hand {
  background: var(--lime);
  bottom: 50%;
  height: 36%;
  left: calc(50% - 1px);
  position: absolute;
  transform-origin: 50% 100%;
  width: 2px;
}

.process-shutter {
  background:
    repeating-linear-gradient(180deg, transparent 0, transparent calc(8.333% - 1px), rgba(38, 49, 63, 0.08) calc(8.333% - 1px), rgba(38, 49, 63, 0.08) 8.333%),
    linear-gradient(135deg, #eef1f0 0%, #dfe4e3 100%);
  color: var(--graphite);
  inset: 0;
  position: absolute;
  will-change: transform;
  z-index: 5;
}

.process-shutter-copy {
  left: clamp(1.5rem, 6vw, 7rem);
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
}

.process-shutter-copy span {
  color: var(--cobalt);
  display: block;
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  margin-bottom: 1.4rem;
  text-transform: uppercase;
}

.process-shutter-copy strong {
  display: block;
  font-size: clamp(3.2rem, 8vw, 9rem);
  font-weight: 400;
  letter-spacing: -0.08em;
  line-height: 0.86;
}

.process-shutter-rail {
  align-items: center;
  background: var(--cobalt);
  bottom: 0;
  color: var(--porcelain);
  display: flex;
  height: clamp(2.75rem, 4vw, 4rem);
  justify-content: space-between;
  left: 0;
  padding: 0 clamp(1.5rem, 5vw, 6rem);
  position: absolute;
  right: 0;
}

.process-shutter-rail span,
.process-roller span {
  font-size: 0.62rem;
  font-style: normal;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.process-shutter-rail i {
  border-bottom: 1px solid currentColor;
  border-right: 1px solid currentColor;
  display: block;
  height: 0.6rem;
  transform: rotate(45deg);
  width: 0.6rem;
}

.process-roller {
  align-items: center;
  background: var(--cobalt);
  box-shadow: 0 0.65rem 2rem rgba(7, 19, 38, 0.24);
  color: var(--porcelain);
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  height: clamp(3rem, 5vw, 4.6rem);
  left: 0;
  padding: 0 clamp(1.5rem, 5vw, 6rem);
  position: absolute;
  right: 0;
  top: 0;
  z-index: 8;
}

.process-roller span:last-child {
  justify-self: end;
}

.process-roller i {
  background: rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  height: 0.35rem;
  width: 0.35rem;
}

.statement {
  background: var(--cobalt);
  color: var(--porcelain);
  overflow: hidden;
  position: relative;
}

.statement-inner {
  align-items: center;
  display: flex;
  min-height: 90svh;
  position: relative;
  z-index: 2;
}

.statement h2 {
  font-size: clamp(3.1rem, 7.25vw, 9rem);
  letter-spacing: -0.085em;
  line-height: 0.9;
  margin: 0;
  max-width: 90rem;
  position: relative;
  z-index: 2;
}

.inline-image {
  border-radius: 999px;
  display: inline-block;
  height: 0.78em;
  margin: 0 0.08em;
  overflow: hidden;
  position: relative;
  transform: translateY(0.07em);
  vertical-align: baseline;
  width: 1.6em;
}

.inline-image img {
  object-fit: cover;
}

.statement-line {
  fill: none;
  opacity: 0.7;
  pointer-events: none;
  position: absolute;
  stroke: var(--lime);
  stroke-linecap: round;
  stroke-width: 1.5;
  width: 38vw;
  z-index: 1;
}

.statement-line-left {
  left: -5vw;
  top: 16%;
}

.statement-line-right {
  bottom: 13%;
  right: -4vw;
  transform: rotate(12deg);
}

.faq {
  background:
    radial-gradient(circle at 50% 45%, rgba(92, 122, 128, 0.3), transparent 38%),
    radial-gradient(circle at 96% 35%, rgba(138, 149, 161, 0.3), transparent 34%),
    radial-gradient(circle at 9% 40%, rgba(238, 241, 240, 0.88), transparent 36%),
    linear-gradient(135deg, var(--porcelain) 0%, rgba(138, 149, 161, 0.42) 100%);
  border-top: 0.45rem solid var(--cobalt);
  color: var(--graphite);
}

.faq-layout {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.faq-intro {
  max-width: 70rem;
}

.faq-intro h2 {
  font-size: clamp(3.5rem, 5.4vw, 6.4rem);
  letter-spacing: -0.07em;
  line-height: 0.93;
  margin: 0;
  max-width: 70rem;
}

.faq-intro p {
  color: rgba(38, 49, 63, 0.72);
  font-size: clamp(1.05rem, 1.35vw, 1.35rem);
  line-height: 1.45;
  margin: 1.5rem 0 0;
  max-width: 42rem;
}

.faq-list {
  display: grid;
  gap: clamp(1rem, 1.7vw, 1.8rem);
  grid-auto-flow: dense;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: clamp(3rem, 5vw, 4.5rem);
}

.faq-item {
  background: linear-gradient(115deg, rgba(238, 241, 240, 0.96), rgba(223, 228, 227, 0.92));
  border: 1px solid rgba(238, 241, 240, 0.86);
  border-radius: 1.45rem;
  box-shadow: 0 1.5rem 3.5rem rgba(38, 49, 63, 0.13);
  min-height: 10.5rem;
  padding: clamp(1.55rem, 2.4vw, 2.15rem);
  will-change: transform;
}

.faq-item h3 {
  font-size: clamp(1.15rem, 1.5vw, 1.45rem);
  letter-spacing: -0.035em;
  line-height: 1.15;
  margin: 0;
}

.faq-item p {
  color: rgba(38, 49, 63, 0.72);
  font-size: 0.98rem;
  line-height: 1.5;
  margin: 0.85rem 0 0;
  max-width: 44rem;
}

.faq-cta-row {
  align-items: center;
  align-self: flex-end;
  display: flex;
  gap: 1.2rem;
  margin-top: 2rem;
}

.faq-cta-row > p {
  color: rgba(38, 49, 63, 0.58);
  font-size: 0.82rem;
  margin: 0;
}

.faq-cta {
  align-items: center;
  background: var(--graphite);
  border: 0;
  border-radius: 999px;
  box-shadow: 0 0.9rem 2rem rgba(38, 49, 63, 0.24);
  color: var(--porcelain);
  cursor: pointer;
  display: inline-flex;
  font-size: 0.9rem;
  font-weight: 700;
  gap: 0.7rem;
  justify-content: center;
  min-height: 3rem;
  padding: 0.75rem 1.35rem;
  transition: background-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
}

.faq-cta:hover,
.faq-cta:focus-visible {
  background: var(--lime);
  box-shadow: 0 1.1rem 2.4rem rgba(38, 49, 63, 0.28);
  color: var(--graphite);
  transform: translateY(-2px);
}

.faq-cta span {
  color: var(--lime);
  font-size: 1.15rem;
  line-height: 1;
}

.faq-cta:hover span,
.faq-cta:focus-visible span {
  color: var(--graphite);
}

.contact {
  background: #dfe4e3;
  color: var(--graphite);
  overflow: hidden;
  position: relative;
}

.contact-layout {
  display: grid;
  gap: clamp(3rem, 9vw, 10rem);
  grid-template-columns: minmax(0, 0.9fr) minmax(300px, 0.8fr);
  position: relative;
  z-index: 1;
}

.contact-copy h2 {
  font-size: clamp(3.3rem, 7.4vw, 9rem);
  letter-spacing: -0.085em;
  line-height: 0.87;
  margin: 1rem 0 1.8rem;
  max-width: 40rem;
}

.contact-copy > p {
  color: rgba(38, 49, 63, 0.64);
  line-height: 1.5;
  max-width: 23rem;
}

.contact .field label {
  color: rgba(38, 49, 63, 0.68);
}

.contact .field input,
.contact .field textarea,
.contact .custom-select-trigger {
  background: rgba(238, 241, 240, 0.82);
  border-color: rgba(38, 49, 63, 0.18);
  color: var(--graphite);
}

.contact .field input:focus,
.contact .field textarea:focus,
.contact .custom-select-trigger:hover,
.contact .custom-select-trigger:focus-visible,
.contact .custom-select.is-open .custom-select-trigger {
  background: var(--porcelain);
  border-color: var(--lime);
}

.contact .custom-select-trigger.is-placeholder {
  color: rgba(38, 49, 63, 0.62);
}

.contact .custom-select-menu {
  background: var(--porcelain);
  border-color: rgba(38, 49, 63, 0.16);
  box-shadow: 0 18px 48px rgba(38, 49, 63, 0.16);
}

.contact .custom-select-menu li {
  color: rgba(38, 49, 63, 0.72);
}

.contact .custom-select-menu li.is-active {
  background: rgba(232, 115, 95, 0.12);
  color: var(--graphite);
}

.contact .form-note {
  color: rgba(38, 49, 63, 0.5);
}

.contact-form {
  display: grid;
  gap: 1rem;
}

.field {
  display: grid;
  gap: 0.45rem;
}

.field label {
  color: rgba(238, 241, 240, 0.72);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.field input,
.field textarea {
  background: #334450;
  border: 1px solid rgba(255, 255, 255, 0.24);
  border-radius: 0.5rem;
  color: var(--porcelain);
  min-height: 3.2rem;
  padding: 0.8rem 0.9rem;
  transition: border-color 180ms ease, background-color 180ms ease;
  width: 100%;
}

.field textarea {
  min-height: 7rem;
  resize: vertical;
}

.field input:focus,
.field textarea:focus {
  background: #40565e;
  border-color: var(--lime);
  outline: none;
}

.custom-select {
  position: relative;
  z-index: 4;
}

.custom-select.is-open {
  z-index: 12;
}

.custom-select-trigger {
  align-items: center;
  background: #334450;
  border: 1px solid rgba(255, 255, 255, 0.24);
  border-radius: 0.5rem;
  color: var(--porcelain);
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  min-height: 3.2rem;
  padding: 0.8rem 0.9rem;
  text-align: left;
  transition: background-color 180ms ease, border-color 180ms ease;
  width: 100%;
}

.custom-select-trigger:hover,
.custom-select-trigger:focus-visible,
.custom-select.is-open .custom-select-trigger {
  background: #40565e;
  border-color: var(--lime);
  outline: none;
}

.custom-select-trigger.is-placeholder {
  color: rgba(238, 241, 240, 0.72);
}

.custom-select-chevron {
  border-bottom: 1.5px solid var(--lime);
  border-right: 1.5px solid var(--lime);
  height: 0.48rem;
  margin: -0.2rem 0.15rem 0 1rem;
  transform: rotate(45deg);
  transition: transform 180ms ease, margin 180ms ease;
  width: 0.48rem;
}

.custom-select.is-open .custom-select-chevron {
  margin-top: 0.2rem;
  transform: rotate(225deg);
}

.custom-select-menu {
  background: #202a37;
  border: 1px solid rgba(255, 255, 255, 0.22);
  border-radius: 0.65rem;
  box-shadow: 0 18px 48px rgba(0, 0, 0, 0.42);
  display: grid;
  gap: 0.2rem;
  left: 0;
  list-style: none;
  margin: 0.4rem 0 0;
  padding: 0.35rem;
  position: absolute;
  right: 0;
  top: 100%;
  z-index: 20;
}

.custom-select-menu li {
  align-items: center;
  border-radius: 0.42rem;
  color: rgba(238, 241, 240, 0.72);
  cursor: pointer;
  display: flex;
  font-size: 0.82rem;
  justify-content: space-between;
  min-height: 2.45rem;
  padding: 0.55rem 0.7rem;
}

.custom-select-menu li.is-active {
  background: rgba(238, 241, 240, 0.08);
  color: var(--porcelain);
}

.custom-select-menu li.is-selected {
  color: var(--lime);
}

.field-error {
  color: var(--lime);
  font-size: 0.7rem;
  min-height: 1em;
}

.form-actions {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 0.6rem;
}

.form-note {
  color: rgba(238, 241, 240, 0.48);
  font-size: 0.7rem;
  line-height: 1.4;
  max-width: 15rem;
}

.form-success {
  background: rgba(232, 115, 95, 0.1);
  border: 1px solid rgba(232, 115, 95, 0.45);
  border-radius: 0.5rem;
  color: var(--lime);
  font-size: 0.78rem;
  line-height: 1.4;
  padding: 0.85rem 1rem;
}

.site-footer {
  background: var(--graphite);
  border-top: 1px solid var(--line-dark);
  color: var(--porcelain);
  padding-block: 1.4rem 2rem;
}

.footer-inner {
  align-items: end;
  display: flex;
  gap: 2rem;
  justify-content: space-between;
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem 1.7rem;
}

.footer-links a,
.footer-email {
  color: rgba(238, 241, 240, 0.58);
  font-size: 0.72rem;
}

.footer-links a:hover,
.footer-links a:focus-visible,
.footer-email:hover,
.footer-email:focus-visible {
  color: var(--porcelain);
}

.footer-meta {
  display: grid;
  gap: 0.55rem;
  justify-items: end;
  text-align: right;
}

.footer-meta small {
  color: rgba(238, 241, 240, 0.36);
  font-size: 0.65rem;
}

.contact-dialog {
  background: var(--graphite);
  border: 1px solid rgba(255, 255, 255, 0.24);
  border-radius: 0.85rem;
  color: var(--porcelain);
  margin: auto;
  max-height: calc(100svh - 2rem);
  max-width: 50rem;
  opacity: 0;
  overflow: visible;
  padding: 0;
  transform: translateY(1.5rem) scale(0.965);
  transform-origin: center;
  transition: opacity 280ms ease, transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  width: calc(100% - 2rem);
}

.contact-dialog::backdrop {
  background: rgba(38, 49, 63, 0);
  backdrop-filter: blur(0);
  transition: background-color 320ms ease, backdrop-filter 320ms ease;
}

.contact-dialog[data-state="open"] {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.contact-dialog[data-state="open"]::backdrop {
  background: rgba(38, 49, 63, 0.68);
  backdrop-filter: blur(8px);
}

.contact-dialog[data-state="closing"] {
  opacity: 0;
  pointer-events: none;
  transform: translateY(1rem) scale(0.975);
}

.dialog-inner {
  overflow: visible;
  padding: clamp(1.25rem, 2.8vw, 2.35rem);
}

.dialog-top {
  align-items: start;
  display: flex;
  gap: 1rem;
  justify-content: space-between;
  margin-bottom: 1.25rem;
}

.dialog-top h2 {
  font-size: clamp(2rem, 4vw, 3.35rem);
  letter-spacing: -0.07em;
  line-height: 0.9;
  margin: 0.55rem 0 0;
}

.contact-form-modal {
  gap: 0.65rem 1rem;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.contact-form-modal .field {
  gap: 0.3rem;
  min-width: 0;
}

.contact-form-modal .field-message,
.contact-form-modal .form-actions,
.contact-form-modal .form-success {
  grid-column: 1 / -1;
}

.contact-form-modal .field input,
.contact-form-modal .custom-select-trigger {
  min-height: 2.85rem;
  padding-block: 0.65rem;
}

.contact-form-modal .field textarea {
  min-height: 5.25rem;
  resize: none;
}

.contact-form-modal .field-error:empty {
  display: none;
}

.contact-form-modal .form-actions {
  margin-top: 0.35rem;
}

.dialog-close {
  align-items: center;
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  color: var(--porcelain);
  cursor: pointer;
  display: inline-flex;
  flex: 0 0 2.4rem;
  font-size: 1.4rem;
  height: 2.4rem;
  justify-content: center;
  line-height: 1;
  width: 2.4rem;
}

.dialog-close:hover,
.dialog-close:focus-visible {
  border-color: var(--lime);
  color: var(--lime);
}

body.modal-open {
  overflow: hidden;
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.001ms !important;
  }

  .process-stage {
    min-height: auto;
  }

  .process-sticky {
    height: auto;
    position: relative;
  }

  .process-content {
    min-height: 100svh;
    opacity: 1 !important;
    transform: none !important;
  }

  .statement-line {
    opacity: 0.35;
  }

}

@media (max-width: 900px) {
  .shell {
    width: min(100% - 1.5rem, 680px);
  }

  .built-for-intro {
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }

  .built-for-intro h2 {
    white-space: normal;
  }

  .built-for-lede {
    max-width: 38rem;
  }

  .built-for-card {
    min-height: 24rem;
  }

  .nav-inner {
    display: flex;
    justify-content: space-between;
    min-height: 4.4rem;
  }

  .nav-links,
  .nav-cta {
    display: none;
  }

  .menu-toggle {
    display: block;
  }

  .mobile-panel {
    background: var(--graphite);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 0.9rem;
    display: grid;
    gap: 0.25rem;
    left: 0;
    padding: 0.7rem;
    position: absolute;
    right: 0;
    top: calc(100% + 0.65rem);
  }

  .mobile-panel a,
  .mobile-panel button {
    background: transparent;
    border: 0;
    border-radius: 0.55rem;
    color: var(--porcelain);
    cursor: pointer;
    font-size: 0.95rem;
    padding: 0.85rem;
    text-align: left;
  }

  .mobile-panel a:hover,
  .mobile-panel button:hover,
  .mobile-panel a:focus-visible,
  .mobile-panel button:focus-visible {
    background: rgba(238, 241, 240, 0.09);
  }

  .mobile-panel .mobile-cta {
    background: var(--lime);
    color: var(--graphite);
    font-weight: 600;
    margin-top: 0.35rem;
    text-align: center;
  }

  .hero-stage {
    min-height: 100svh;
  }

  .hero-sticky {
    min-height: 100svh;
    padding-bottom: 4.5rem;
    padding-top: 8.5rem;
  }

  .bento {
    grid-template-rows: repeat(2, minmax(15rem, 1fr));
  }

  .outcome-card {
    min-height: 15rem;
  }

  .capability-layout,
  .faq-layout,
  .contact-layout {
    gap: 3rem;
    grid-template-columns: 1fr;
  }

  .capability-detail {
    min-height: 28rem;
  }

  .process-stage {
    min-height: 240svh;
  }

  .process-sticky {
    height: 100svh;
    position: sticky;
  }

  .process-content {
    gap: 1.5rem;
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr;
    padding-top: clamp(5.8rem, 10vh, 7rem);
  }

  .process-heading {
    max-width: 46rem;
  }

  .process-heading h2 {
    font-size: clamp(3.8rem, 11vw, 7rem);
    max-width: none;
  }

  .process-heading > p:last-child {
    margin-top: 1.25rem;
    max-width: 42rem;
  }

  .process-day {
    align-self: center;
    margin-left: 0;
    max-width: 46rem;
    width: 100%;
  }

  .process-clock {
    height: min(74vw, 34rem);
    left: 72%;
    top: 54%;
    width: min(74vw, 34rem);
  }

  .statement-inner {
    min-height: 70svh;
  }

  .statement-line {
    width: 55vw;
  }
}

@media (max-width: 600px) {
  .section-pad {
    padding-block: 5.5rem;
  }

  .built-for.section-pad {
    padding-block: 0.75rem;
  }

  .built-for-intro {
    margin-bottom: 3.5rem;
  }

  .built-for-intro h2 {
    font-size: clamp(3.4rem, 16vw, 5.4rem);
  }

  .built-for-grid {
    grid-template-columns: 1fr;
  }

  .built-for-card,
  .built-for-card:nth-child(4n + 1),
  .built-for-card:nth-child(4n + 4) {
    min-height: 22rem;
  }

  .built-for-card-copy h3 {
    font-size: clamp(2.5rem, 12vw, 4rem);
  }

  .hero-copy h1 {
    font-size: clamp(2.6rem, 12vw, 4.25rem);
  }

  .hero-actions {
    align-items: stretch;
    flex-direction: column;
    max-width: 21rem;
    width: 100%;
  }

  .hero-actions .button {
    width: 100%;
  }

  .hero-message {
    font-size: clamp(3rem, 14vw, 4.75rem);
    margin-block: 0.9rem 1.4rem;
  }

  .hero-ring-large {
    height: 36rem;
    right: -17rem;
    top: -9.5rem;
    width: 36rem;
  }

  .hero-ring-small {
    bottom: -4rem;
    height: 16rem;
    left: -6rem;
    width: 16rem;
  }

  .outcome-statement {
    padding-block: 6.5rem;
  }

  .outcome-statement-copy {
    gap: 0.7rem;
  }

  .outcome-statement-line {
    font-size: clamp(2.5rem, 12.5vw, 4rem);
  }

  .outcome-statement-line-wide {
    font-size: clamp(1.75rem, 7.5vw, 2.65rem);
    letter-spacing: -0.055em;
  }

  .section-intro {
    align-items: start;
    flex-direction: column;
  }

  .bento {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: none;
  }

  .outcome-card,
  .outcome-card:nth-child(1),
  .outcome-card:nth-child(2),
  .outcome-card:nth-child(3),
  .outcome-card:nth-child(4) {
    grid-column: auto;
    grid-row: auto;
    min-height: 16rem;
  }

  .capability-bullets {
    grid-template-columns: 1fr;
    margin-top: 2.3rem;
  }

  .capability-bullets li::before {
    display: inline-block;
    margin: 0 0.6rem 0 0;
  }

  .process-stage {
    min-height: 220svh;
  }

  .process-content {
    gap: 0.9rem;
    padding: 4.5rem 1.25rem 1.25rem;
  }

  .process-kicker {
    font-size: 0.6rem;
    margin-bottom: 0.8rem;
  }

  .process-heading h2 {
    font-size: clamp(3.25rem, 15vw, 5rem);
  }

  .process-heading > p:last-child {
    font-size: 0.86rem;
    line-height: 1.38;
    margin-top: 0.9rem;
  }

  .process-moment {
    gap: 0.75rem;
    grid-template-columns: 3.55rem 1fr;
    padding: 0.72rem 0;
  }

  .process-moment.is-active {
    transform: translateX(-0.3rem);
  }

  .process-moment time {
    font-size: 0.61rem;
  }

  .process-moment h3 {
    font-size: 1.2rem;
    margin-bottom: 0.35rem;
  }

  .process-moment p {
    font-size: 0.76rem;
    line-height: 1.34;
  }

  .process-bottomline {
    display: none;
  }

  .process-shutter-copy {
    left: 1.25rem;
    right: 1.25rem;
  }

  .process-shutter-copy strong {
    font-size: clamp(3rem, 15vw, 5rem);
  }

  .process-shutter-rail,
  .process-roller {
    padding-inline: 1.25rem;
  }

  .process-shutter-rail span,
  .process-roller span {
    font-size: 0.52rem;
  }

  .statement-inner {
    min-height: 64svh;
  }

  .statement-line {
    opacity: 0.25;
    width: 90vw;
  }

  .footer-inner {
    align-items: start;
    flex-direction: column;
  }

  .footer-meta {
    justify-items: start;
    text-align: left;
  }
}

/* Motion language */
.reveal-mask {
  overflow: hidden;
}

.reveal-mask > div {
  will-change: transform, opacity;
}

.hero-title-reveal {
  margin-bottom: -0.34em;
  margin-top: 0;
  padding-bottom: 0.34em;
}

.hero-title-reveal h1 {
  margin-top: 0;
}

.ambient-lines {
  fill: none;
  height: clamp(12rem, 24vw, 25rem);
  left: 0;
  opacity: 0.34;
  pointer-events: none;
  position: absolute;
  width: 100%;
  z-index: 0;
}

.ambient-lines svg {
  fill: none;
  height: 100%;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-width: 1.25;
  width: 100%;
}

.ambient-lines-ghost {
  opacity: 0.18;
  stroke-dasharray: 4 9;
}

/* Bespoke routing visual system */
.feature-system-icon {
  fill: none;
  height: clamp(6.5rem, 10vw, 9.5rem);
  overflow: visible;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.45;
  transition: opacity 360ms ease, transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  width: clamp(8.5rem, 13vw, 12rem);
}

.feature-system-icon circle,
.feature-system-icon rect {
  fill: currentColor;
  stroke: none;
  transform-box: fill-box;
  transform-origin: center;
}

.feature-system-icon .is-secondary {
  opacity: 0.34;
  stroke-dasharray: 3 5;
}

.feature-system-icon circle.is-secondary,
.feature-system-icon rect.is-secondary {
  opacity: 0.36;
}

.feature-system-icon .is-active {
  color: var(--lime);
  fill: var(--lime);
  stroke: var(--lime);
}

.outcome-lime .feature-system-icon .is-active {
  color: var(--cobalt);
  fill: var(--cobalt);
  stroke: var(--cobalt);
}

.outcome-cobalt .feature-system-icon .is-active {
  color: var(--sky);
  fill: var(--sky);
  stroke: var(--sky);
}

.section-svg-system {
  color: currentColor;
  pointer-events: none;
  position: absolute;
  z-index: 0;
}

.section-svg-system svg {
  height: 100%;
  overflow: visible;
  width: 100%;
}

.section-svg-system path {
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.15;
}

.section-svg-system path.is-secondary {
  opacity: 0.32;
  stroke-dasharray: 4 8;
}

.section-svg-system path.is-active {
  stroke: var(--lime);
  stroke-width: 1.7;
}

.section-svg-system circle,
.section-svg-system rect {
  fill: var(--porcelain);
  stroke: currentColor;
  stroke-width: 1.2;
  transform-box: fill-box;
  transform-origin: center;
}

.section-svg-system circle.is-secondary,
.section-svg-system rect.is-secondary {
  opacity: 0.38;
}

.section-svg-system circle.is-active,
.section-svg-system rect.is-active {
  fill: var(--lime);
  stroke: var(--lime);
}

.section-svg-system text {
  fill: currentColor;
  font-size: 8px;
  font-weight: 600;
  letter-spacing: 0.14em;
  opacity: 0.45;
}

.outcomes-system {
  color: var(--cobalt);
  height: 82%;
  opacity: 0.22;
  right: -7rem;
  top: 7%;
  width: min(29vw, 25rem);
}

.capabilities-system {
  color: var(--lime);
  height: 78%;
  opacity: 0.16;
  right: -9rem;
  top: 11%;
  width: min(48vw, 43rem);
}

.capabilities-system circle,
.capabilities-system rect,
.statement-system circle,
.statement-system rect,
.contact-system circle,
.contact-system rect {
  fill: var(--surface);
}

.capabilities-system circle.is-active,
.capabilities-system rect.is-active,
.statement-system circle.is-active,
.statement-system rect.is-active,
.contact-system circle.is-active,
.contact-system rect.is-active {
  fill: var(--lime);
}

.process-system {
  color: var(--cobalt);
  height: 76%;
  left: -10rem;
  opacity: 0.17;
  top: 12%;
  width: min(43vw, 38rem);
}

.statement-system {
  color: var(--porcelain);
  height: 72%;
  opacity: 0.3;
  right: -8rem;
  top: 14%;
  width: min(52vw, 48rem);
  z-index: 2;
}

.faq-system {
  color: var(--cobalt);
  height: 82%;
  opacity: 0.15;
  right: -4.5rem;
  top: 7%;
  width: min(18vw, 16rem);
}

.contact-system {
  color: var(--lime);
  height: 88%;
  left: -5rem;
  opacity: 0.16;
  top: 3%;
  width: min(18vw, 15rem);
}

/* Outcomes */
.outcomes {
  overflow: hidden;
  position: relative;
}

.outcomes-inner {
  position: relative;
  z-index: 1;
}

.outcomes-lines {
  color: var(--cobalt);
  right: -6%;
  top: 3rem;
  width: 112%;
}

.outcome-grid {
  display: grid;
  gap: 1rem;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.outcome-card-new {
  background: var(--surface);
  border: 1px solid rgba(38, 49, 63, 0.13);
  border-radius: 1.15rem;
  display: flex;
  flex-direction: column;
  isolation: isolate;
  justify-content: space-between;
  min-height: clamp(25rem, 38vw, 36rem);
  overflow: hidden;
  padding: clamp(1.4rem, 3vw, 3rem);
  position: relative;
  transition: background-color 420ms cubic-bezier(0.16, 1, 0.3, 1), border-color 420ms ease, box-shadow 500ms cubic-bezier(0.16, 1, 0.3, 1), color 320ms ease, translate 500ms cubic-bezier(0.16, 1, 0.3, 1);
}

.outcome-card-new::before {
  background: var(--graphite);
  content: "";
  inset: 0;
  position: absolute;
  transform: scaleY(0);
  transform-origin: center bottom;
  transition: transform 760ms cubic-bezier(0.65, 0, 0.35, 1);
  will-change: transform;
  z-index: 0;
}

.outcome-card-new.outcome-lime {
  background: var(--lime);
}

.outcome-card-new.outcome-cobalt {
  background: var(--cobalt);
  border-color: var(--cobalt);
  color: var(--porcelain);
}

.outcome-card-new.outcome-mist {
  background: var(--mist);
}

.outcome-card-new:hover {
  border-color: rgba(255, 255, 255, 0.2);
  box-shadow: 0 30px 70px rgba(38, 49, 63, 0.14);
  color: var(--porcelain);
  translate: 0 -0.45rem;
}

.outcome-card-new:hover::before {
  transform: scaleY(1);
}

.outcome-card-top {
  align-items: flex-start;
  display: flex;
  justify-content: space-between;
  position: relative;
  z-index: 2;
}

.outcome-index {
  border: 1px solid currentColor;
  border-radius: 999px;
  font-size: 0.68rem;
  letter-spacing: 0.1em;
  opacity: 0.55;
  padding: 0.45rem 0.65rem;
  transition: background-color 320ms ease, border-color 320ms ease, color 320ms ease, opacity 320ms ease;
}

.outcome-card-new:hover .outcome-index {
  background: rgba(232, 115, 95, 0.12);
  border-color: rgba(232, 115, 95, 0.6);
  color: var(--lime);
  opacity: 1;
}

.outcome-card-new:hover .feature-system-icon {
  opacity: 0;
  transform: rotate(7deg) scale(0.78);
}

.outcome-card-copy {
  padding-bottom: 2.75rem;
  position: relative;
  z-index: 2;
}

.outcome-card-wordmark {
  bottom: clamp(1.4rem, 3vw, 3rem);
  color: var(--porcelain);
  opacity: 0;
  position: absolute;
  right: clamp(1.4rem, 3vw, 3rem);
  transform: translateY(0.85rem);
  transition: opacity 300ms ease, transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 3;
}

.outcome-card-wordmark span {
  color: var(--sky);
}

.outcome-card-new:hover .outcome-card-wordmark {
  opacity: 1;
  transform: translateY(0);
}

.outcome-icon {
  fill: none;
  height: clamp(5.5rem, 9vw, 8.5rem);
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.6;
  width: clamp(6rem, 10vw, 9.5rem);
}

.outcome-card-new .card-note {
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  margin: 0 0 1.2rem;
  text-transform: uppercase;
}

.outcome-card-new h3 {
  font-size: clamp(2rem, 4vw, 4.5rem);
  letter-spacing: -0.07em;
  line-height: 0.94;
  margin: 0;
  max-width: 29rem;
}

.outcome-card-new .outcome-description {
  font-size: clamp(0.95rem, 1.2vw, 1.12rem);
  line-height: 1.5;
  margin: 1.45rem 0 0;
  max-width: 27rem;
  opacity: 0.68;
}

/* Scroll-locked capabilities story */
.capabilities-scroll {
  background: #dfe4e3;
  color: var(--graphite);
  min-height: 320svh;
  overflow: clip;
  position: relative;
}

.capabilities-lines {
  color: var(--lime);
  opacity: 0.14;
  top: 20%;
}

.capabilities-sticky {
  align-items: center;
  display: grid;
  gap: clamp(2rem, 6vw, 7rem);
  grid-template-columns: minmax(18rem, 0.78fr) minmax(0, 1.22fr);
  height: 100svh;
  padding-block: clamp(5rem, 8vh, 7.5rem) clamp(2rem, 4vh, 4rem);
  position: sticky;
  top: 0;
  z-index: 1;
}

.capabilities-heading h2 {
  font-size: clamp(3rem, 6vw, 7.2rem);
  letter-spacing: -0.075em;
  line-height: 0.9;
  margin: 1rem 0 1.7rem;
}

.capabilities-heading > .reveal-mask:last-child p {
  color: rgba(38, 49, 63, 0.62);
  line-height: 1.5;
  margin: 0;
  max-width: 25rem;
}

.capabilities-story {
  display: grid;
  gap: 1.25rem;
  grid-template-columns: 2px minmax(8rem, 0.42fr) minmax(0, 1fr);
  min-height: min(72vh, 42rem);
}

.capability-rail {
  background: rgba(38, 49, 63, 0.13);
  overflow: hidden;
  position: relative;
}

.capability-rail span {
  background: var(--lime);
  inset: 0;
  position: absolute;
  transform-origin: top;
}

.capability-step-list {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding-block: 0.6rem;
}

.capability-step-list button {
  background: transparent;
  border: 0;
  color: rgba(38, 49, 63, 0.4);
  cursor: pointer;
  display: grid;
  font-size: clamp(1rem, 1.5vw, 1.3rem);
  gap: 0.45rem;
  padding: 0;
  text-align: left;
  transition: color 320ms ease, transform 320ms ease;
}

.capability-step-list button span {
  font-size: 0.64rem;
  letter-spacing: 0.12em;
}

.capability-step-list button.is-active {
  color: var(--lime);
  transform: translateX(0.45rem);
}

.capability-story-card {
  background: var(--surface);
  border: 1px solid rgba(38, 49, 63, 0.12);
  box-shadow: 0 28px 70px rgba(38, 49, 63, 0.1);
  border-radius: 1.2rem;
  min-width: 0;
  overflow: hidden;
  padding: clamp(1.5rem, 3vw, 3rem);
  position: relative;
}

.capability-story-card > div {
  align-content: end;
  display: grid;
  inset: 0;
  padding: clamp(1.5rem, 3vw, 3rem);
  padding-top: clamp(11rem, 17vw, 14rem);
  position: absolute;
}

.capability-sketch {
  fill: none;
  height: clamp(5.6rem, 8vw, 6.6rem);
  position: absolute;
  right: 6%;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.25;
  top: 1.5%;
  width: clamp(8.5rem, 12vw, 10rem);
}

.capability-sketch path {
  stroke: rgba(38, 49, 63, 0.48);
}

.capability-sketch path.is-secondary {
  stroke-dasharray: 3 6;
}

.capability-sketch path.is-active {
  stroke: var(--lime);
  stroke-width: 1.75;
}

.capability-sketch circle {
  fill: var(--surface);
  stroke: rgba(38, 49, 63, 0.62);
  stroke-width: 1.2;
  transform-box: fill-box;
  transform-origin: center;
}

.capability-sketch circle.is-active {
  fill: var(--lime);
  stroke: var(--lime);
}

.capability-story-card h3 {
  font-size: clamp(2.4rem, 4.5vw, 5.2rem);
  letter-spacing: -0.07em;
  line-height: 0.9;
  margin: 1rem 0 1.2rem;
}

.capability-story-card p:not(.eyebrow) {
  color: rgba(38, 49, 63, 0.64);
  line-height: 1.5;
  margin: 0;
  max-width: 31rem;
}

.capability-story-card ul {
  border-top: 1px solid rgba(38, 49, 63, 0.14);
  display: grid;
  gap: 0.55rem;
  list-style: none;
  margin: 1.8rem 0 0;
  padding: 1.25rem 0 0;
}

.capability-story-card li {
  color: rgba(38, 49, 63, 0.76);
  font-size: 0.78rem;
}

.capability-story-card li::before {
  color: var(--lime);
  content: "↗";
  margin-right: 0.7rem;
}

.scroll-cue {
  align-items: center;
  bottom: 1.4rem;
  color: rgba(38, 49, 63, 0.48);
  display: flex;
  font-size: 0.66rem;
  gap: 0.65rem;
  letter-spacing: 0.11em;
  position: absolute;
  right: 0;
  text-transform: uppercase;
}

.scroll-cue i {
  animation: cue-bob 1.8s ease-in-out infinite;
  color: var(--lime);
  font-style: normal;
}

@keyframes cue-bob {
  50% { transform: translateY(0.3rem); }
}

/* Full-image statement banner */
.statement-wrap {
  background: var(--porcelain);
}

.statement {
  background: var(--graphite);
  border-radius: 1.2rem;
  color: var(--porcelain);
  min-height: 31.25rem;
  overflow: hidden;
  position: relative;
}

.statement-media,
.statement-image,
.statement-wash {
  inset: 0;
  position: absolute;
}

.statement-media {
  overflow: hidden;
  z-index: 0;
}

.statement-image img {
  filter: grayscale(1) saturate(0) contrast(1.08);
  object-fit: cover;
  object-position: center 58%;
}

.statement-wash {
  background: linear-gradient(90deg, rgba(38, 49, 63, 0.96) 0%, rgba(92, 122, 128, 0.82) 55%, rgba(232, 115, 95, 0.22) 100%);
  z-index: 1;
}

.statement-route {
  fill: none;
  height: 45%;
  left: 0;
  opacity: 0.72;
  pointer-events: none;
  position: absolute;
  stroke: var(--lime);
  stroke-linecap: round;
  stroke-width: 2;
  top: 44%;
  width: 100%;
  z-index: 2;
}

.statement .statement-inner {
  align-items: flex-start;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 31.25rem;
  padding: 3.5rem clamp(2rem, 5vw, 5rem);
  position: relative;
  z-index: 3;
}

.statement .statement-inner .eyebrow {
  color: rgba(255, 255, 255, 0.65);
  margin: 0 0 1.5rem;
}

.statement .statement-inner h2 {
  font-size: clamp(2.8rem, 4.8vw, 5.8rem);
  letter-spacing: -0.08em;
  line-height: 0.9;
  margin: 0;
  max-width: 68rem;
}

.statement .statement-inner .button {
  background: var(--lime);
  color: var(--graphite);
  margin-top: 2rem;
}

.statement .statement-inner .button:hover,
.statement .statement-inner .button:focus-visible {
  background: var(--sky);
}

.site-footer .wordmark span {
  color: var(--sky);
}

/* FAQ */
.faq {
  overflow: hidden;
  position: relative;
}

.faq-layout {
  position: relative;
  z-index: 1;
}

@media (max-width: 1000px) {
  .faq-layout {
    gap: 0;
  }

  .capabilities-sticky {
    gap: 2rem;
    grid-template-columns: minmax(15rem, 0.72fr) minmax(0, 1.28fr);
  }

  .capabilities-story {
    grid-template-columns: 2px 6rem minmax(0, 1fr);
  }
}

@media (max-width: 760px) {
  .faq {
    border-top-width: 0.3rem;
  }

  .faq-intro h2 {
    font-size: clamp(3rem, 13vw, 5rem);
  }

  .faq-list {
    grid-template-columns: 1fr;
  }

  .faq-item {
    min-height: 0;
  }

  .faq-cta-row {
    align-items: stretch;
    align-self: stretch;
    flex-direction: column;
    margin-top: 1.5rem;
  }

  .faq-cta-row > p {
    text-align: center;
  }

  .hero-title-reveal {
    margin-bottom: -0.34em;
    margin-top: 0;
    padding-bottom: 0.34em;
  }

  .outcome-grid {
    grid-template-columns: 1fr;
  }

  .outcome-card-new {
    min-height: 24rem;
  }

  .capabilities-scroll {
    min-height: 300svh;
  }

  .capabilities-sticky {
    align-content: center;
    display: block;
    height: 100svh;
    padding-block: 5.5rem 1.5rem;
  }

  .capabilities-heading h2 {
    font-size: clamp(2.55rem, 11vw, 4.4rem);
    margin-block: 0.65rem 0.9rem;
  }

  .capabilities-heading > .reveal-mask:last-child {
    display: none;
  }

  .capabilities-story {
    gap: 0.8rem;
    grid-template-columns: 2px 4.6rem minmax(0, 1fr);
    margin-top: 1.7rem;
    min-height: 56svh;
  }

  .capability-step-list button {
    font-size: 0.76rem;
  }

  .capability-story-card {
    min-height: 56svh;
    padding: 1.2rem;
  }

  .capability-story-card > div {
    padding: 1.2rem;
    padding-top: 7.5rem;
  }

  .capability-story-card h3 {
    font-size: clamp(2rem, 10vw, 3.3rem);
    margin-block: 0.65rem 0.8rem;
  }

  .capability-story-card p:not(.eyebrow) {
    font-size: 0.84rem;
  }

  .capability-story-card ul {
    margin-top: 1.1rem;
    padding-top: 0.9rem;
  }

  .capability-story-card li {
    font-size: 0.7rem;
  }

  .capability-sketch {
    height: 5.8rem;
    right: 0.9rem;
    top: 0.45rem;
    width: 8.7rem;
  }

  .scroll-cue {
    display: none;
  }

  .statement,
  .statement .statement-inner {
    min-height: 33rem;
  }

  .statement .statement-inner {
    padding: 2.2rem 1.4rem;
  }

  .statement-wash {
    background: linear-gradient(90deg, rgba(38, 49, 63, 0.94), rgba(92, 122, 128, 0.72));
  }

  .statement .statement-inner h2 {
    font-size: clamp(2.55rem, 11vw, 4.5rem);
  }

  .ambient-lines {
    opacity: 0.2;
  }

  .section-svg-system {
    opacity: 0.1;
  }

  .outcomes-system {
    height: 68%;
    right: -7rem;
    top: 14%;
    width: 16rem;
  }

  .capabilities-system {
    height: 58%;
    right: -11rem;
    top: 20%;
    width: 24rem;
  }

  .process-system {
    height: 58%;
    left: -9rem;
    top: 18%;
    width: 22rem;
  }

  .statement-system {
    height: 58%;
    opacity: 0.2;
    right: -11rem;
    top: 23%;
    width: 27rem;
  }

  .faq-system,
  .contact-system {
    width: 11rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .capabilities-scroll {
    min-height: auto;
    padding-block: 6rem;
  }

  .capabilities-sticky {
    height: auto;
    position: relative;
  }

  .scroll-cue {
    display: none;
  }

  .process-stage {
    min-height: auto;
  }

  .process-sticky {
    height: auto;
    position: relative;
  }

  .process-content {
    min-height: 100svh;
    opacity: 1 !important;
    transform: none !important;
  }
}
